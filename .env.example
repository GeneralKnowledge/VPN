# =============================================================================
# Northstar VPN — environment template
# Copy to .env.local for development. Never commit real credentials.
# =============================================================================

# --- Application ---
APP_URL=http://localhost:3000
# Public URL for the eSIM host (checkout returns / emails). Defaults to APP_URL if unset.
# ESIM_APP_URL=http://sim.localhost:3000
# development | test | production
APP_ENV=development
APP_NAME=Northstar VPN

# --- Multi-product hosts (comma-separated hostnames, no scheme) ---
# Unmatched hosts default to the VPN product so localhost:3000 keeps working.
PRODUCT_HOST_VPN=vpn.localhost,vpn.example.com
PRODUCT_HOST_ESIM=sim.localhost,sim.example.com
# Only "true" behind a proxy that overwrites X-Forwarded-Host (never on a raw public Node).
TRUST_FORWARDED_HOST=false

# --- Database ---
# Local / CI (default): SQLite file
DATABASE_URL=file:./data/northstar.db
# Production: Postgres (apply packages/db/src/postgres.migrate.sql)
# DATABASE_URL=postgres://user:pass@host:5432/northstar

# --- Authentication ---
# Use a long random secret in production (openssl rand -base64 48)
AUTH_SECRET=dev-only-change-me-in-production-use-openssl-rand
AUTH_URL=http://localhost:3000

# --- VPN Provider ---
# Local development: mock (no external account required)
VPN_PROVIDER=mock
# Production / staging with real reseller:
# VPN_PROVIDER=vpnresellers
VPNRESELLERS_API_URL=https://api.vpnresellers.com/v4_1
VPNRESELLERS_API_TOKEN=
VPNRESELLERS_TIMEOUT_MS=15000
# Optional — when set, account create attaches a customer object
VPNRESELLERS_PROJECT_ID=

# --- eSIM Provider ---
# Local development: mock (fixture packages + fake QR)
ESIM_PROVIDER=mock
# Production / staging with ResellPortal:
# ESIM_PROVIDER=resellportal
RESELLPORTAL_API_URL=https://panel.resellportal.com/wp-json/resellportal/v1
RESELLPORTAL_API_KEY=
RESELLPORTAL_API_SECRET=
RESELLPORTAL_TIMEOUT_MS=15000

# --- Cron / reconciliation ---
# Bearer token for POST/GET /api/reconcile (in addition to admin session). Compared in
# constant time. Reconcile also expires lapsed subscriptions, so it MUST be scheduled in production.
CRON_SECRET=

# --- Billing (mock is sufficient for VPN launch readiness) ---
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
# Required to accept POST /api/webhooks/stripe — even with BILLING_PROVIDER=mock.
# Leave empty to reject all billing webhooks (fail closed). Mock checkout via
# /api/billing/complete does not need this secret. Required in production when BILLING_PROVIDER=stripe.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Shared secret for POST /api/webhooks/vpnresellers. No fallback to CRON_SECRET: leave empty to reject all.
VPNRESELLERS_WEBHOOK_SECRET=

# Production refuses BILLING_PROVIDER=mock (it grants free subscriptions) unless this is "true".
# Only for staging/demo deployments.
ALLOW_MOCK_BILLING_IN_PRODUCTION=false

# --- Email (mock is sufficient for this stage) ---
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Northstar VPN <noreply@localhost>

# --- Analytics ---
ANALYTICS_PROVIDER=mock
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Error reporting ---
ERROR_REPORTER=console
SENTRY_DSN=

# --- Seed users (development only — never use these in production) ---
# Where the public contact form delivers (defaults to SEED_ADMIN_EMAIL)
SUPPORT_INBOX_EMAIL=
SEED_ADMIN_EMAIL=admin@northstar.local
SEED_ADMIN_PASSWORD=AdminDev123!
SEED_CUSTOMER_EMAIL=customer@northstar.local
SEED_CUSTOMER_PASSWORD=CustomerDev123!
