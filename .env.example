# Application
APP_URL=http://localhost:3000
APP_ENV=development
APP_NAME=Northstar VPN

# Database (SQLite file path for local; use postgres://... in production)
DATABASE_URL=file:./data/northstar.db

# Authentication
AUTH_SECRET=dev-only-change-me-in-production-use-openssl-rand
AUTH_URL=http://localhost:3000

# VPN Provider: mock | vpnresellers
VPN_PROVIDER=mock
VPNRESELLERS_API_URL=https://api.vpnresellers.com/v4_1
VPNRESELLERS_API_TOKEN=
VPNRESELLERS_TIMEOUT_MS=15000

# Billing: mock | stripe
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Optional Stripe price IDs when using live Stripe
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Email: mock | smtp
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Northstar VPN <noreply@localhost>

# Analytics: mock | posthog
ANALYTICS_PROVIDER=mock
POSTHOG_API_KEY=
POSTHOG_HOST=

# Error reporting: console | sentry
ERROR_REPORTER=console
SENTRY_DSN=

# Admin seed (development only — never use in production)
SEED_ADMIN_EMAIL=admin@northstar.local
SEED_ADMIN_PASSWORD=AdminDev123!
SEED_CUSTOMER_EMAIL=customer@northstar.local
SEED_CUSTOMER_PASSWORD=CustomerDev123!
