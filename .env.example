# =============================================================================
# Northstar VPN — environment template
# Copy to .env.local for development. Never commit real credentials.
# =============================================================================

# --- Application ---
APP_URL=http://localhost:3000
# development | test | production
APP_ENV=development
APP_NAME=Northstar VPN

# --- Database ---
# Local / CI (default): SQLite file
DATABASE_URL=file:./data/northstar.db
# Production: Postgres (apply packages/db/src/postgres.migrate.sql)
# DATABASE_URL=postgres://user:pass@host:5432/northstar

# --- Authentication ---
# Use a long random secret in production (openssl rand -base64 48)
AUTH_SECRET=dev-only-change-me-in-production-use-openssl-rand
AUTH_URL=http://localhost:3000

# --- VPN Provider ---
# Local development: mock (no external account required)
VPN_PROVIDER=mock
# Production / staging with real reseller:
# VPN_PROVIDER=vpnresellers
VPNRESELLERS_API_URL=https://api.vpnresellers.com/v4_1
VPNRESELLERS_API_TOKEN=
VPNRESELLERS_TIMEOUT_MS=15000
# Optional — when set, account create attaches a customer object
VPNRESELLERS_PROJECT_ID=

# --- Cron / reconciliation ---
# Bearer token for POST /api/reconcile (in addition to admin session)
CRON_SECRET=

# --- Billing (mock is sufficient for VPN launch readiness) ---
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
# Required to accept POST /api/webhooks/stripe — even with BILLING_PROVIDER=mock.
# Leave empty to reject all billing webhooks (fail closed). Mock checkout via
# /api/billing/complete does not need this secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Optional shared secret for POST /api/webhooks/vpnresellers (falls back to CRON_SECRET)
VPNRESELLERS_WEBHOOK_SECRET=

# --- Email (mock is sufficient for this stage) ---
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Northstar VPN <noreply@localhost>

# --- Analytics ---
ANALYTICS_PROVIDER=mock
POSTHOG_API_KEY=
POSTHOG_HOST=

# --- Error reporting ---
ERROR_REPORTER=console
SENTRY_DSN=

# --- Seed users (development only — never use these in production) ---
SEED_ADMIN_EMAIL=admin@northstar.local
SEED_ADMIN_PASSWORD=AdminDev123!
SEED_CUSTOMER_EMAIL=customer@northstar.local
SEED_CUSTOMER_PASSWORD=CustomerDev123!
